# LLM プロバイダ: openai / anthropic / ollama（ローカルのオープンウェイト・APIキー不要）
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ollama を使う場合の例:
#   LLM_PROVIDER=ollama
#   LLM_MODEL=qwen3:14b      # ツール呼び出し(Function Calling)対応モデルを選ぶ
OLLAMA_BASE_URL=http://localhost:11434

# LangSmith（フェーズ4）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=vmgs
